import("//build/package.gni")
import("//build/nebula/nbl_sdk_library.gni")
import("BUILD.generated_tests.gni")

# GRT(TODO):
# 1. miss libssl.
# 2. don't add method add the libcrypto.so to HEE image.

################################################################################
# Public targets
package("openssl_test") {
    testonly = true
    system_image = true
    deps = [
      ":nebula_openssl_test"
    ]
    tests = [
    {
         destdir="openssl_test"  name = "nebula_openssl_test"
    },
    ]
  }

executable("nebula_openssl_test") {
    testonly = true
    visibility = [":*"]
    sources = openssl_test_sources  + openssl_test_support_sources
    configs += [":openssl_test_config",":no_network"]
    deps = [
      "//third_party/googletest:gtest",
    ]
    lib_dirs = [
    "//out/build-openssl"
    ]
    libs = [
        "crypto",
        "ssl"
    ]
}

config("openssl_config") {
  include_dirs = [
    "//third_party/openssl/include",
    "//out/build-openssl/include",
  ]
  defines = [
  ]
}

static_library("libopenssl_crypto") {
  lib_dirs = [
    "//out/build-openssl"
  ]

  libs = [
    "openssl_static_crypto",   # libcrypto.a
  ]

  public_configs = [ ":openssl_config" ]
}

################################################################################
# Configs
config("crypto_config") {
  include_dirs = [
    "//third_party/openssl/include",
    "//out/build-openssl/include",
  ]

  libs = ["//out/build-openssl/libopenssl_crypto.so"]

  visibility = [
    ":*",
  ]
}

config("openssl_test_config") {
  visibility = [ ":*" ]
  include_dirs = [
    "//third_party/openssl/",
    "//out/build-openssl/include",
    "//third_party/openssl/include",
    "//third_party/openssl/test",
    "//third_party/openssl/apps",
    "//third_party/openssl/crypto/ec",
    "///third_party/openssl/crypto/ec/curve448",
    "//third_party/googletest/googletest/include",
    "//zircon/trusty/lib/include/user",
  ]
}

# When network is NOT OK, use this config.
config("no_network") {
  # Not test "BIOTest.SocketConnect" which depends on Network.
  defines = ["NO_TEST_SOCKET_CONNECT"]
}

###########################################################
## SDK

nbl_sdk_library("openssl_sdk") {
  name = "openssl"
  category = "hee"
  hdr_dir = "include"
  deps = [
    ":libopenssl_crypto",
  ]
  files = [
    {
      source = "//out/build-openssl/include/openssl/opensslconf.h"
      dest = "include/openssl/opensslconf.h"
    },
    {
      source = "//out/build-openssl/libcrypto.a"
      dest = "lib/libopenssl_crypto.a"
    },
  ]
}
